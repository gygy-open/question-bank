# 本地开发环境示例
# 生产环境请复制根目录 .env.example，并通过 docker-compose 加载

# JWT 签名密钥，生产环境必须替换
# 生成命令: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

LOG_LEVEL=INFO

# 数据库连接串
DB_URL=mysql+aiomysql://question_bank:change-me@localhost:3306/question_bank

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
# 留空 = 自动判断: 打包桌面版用 embedded, 使用 sqlite 数据库时也用 embedded, 否则 http
# 可选值: embedded (本地 PersistentClient) | http (连接独立 ChromaDB 服务)
CHROMADB_MODE=
