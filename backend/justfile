migrate:
    alembic upgrade head

make_migration msg: 
    uv run alembic revision --autogenerate -m "{{msg}}"

test:
    uv run pytest

# Sync the vendored MathType parser (app/services/importing/mathtype) from upstream.
# Usage: just sync-mathtype            (latest)   |   just sync-mathtype <sha|tag>
sync-mathtype ref="HEAD":
    uv run python scripts/sync_mathtype.py --ref {{ref}}
    git diff --stat -- app/services/importing/mathtype tests/fixtures/mathtype
    uv run pytest tests/test_importing_docx_math.py tests/test_importing_ingest.py -q

# --- Desktop packaging ---------------------------------------------------

# Build the frontend SPA so it can be bundled into the desktop executable.
build-frontend:
    cd ../frontend && pnpm install && pnpm generate

# Produce the desktop build (runs migrations + API + worker + serves the bundled
# SPA): dist/question-bank.exe on Windows, dist/QuestionBank.app on macOS.
package: build-frontend
    uv run --with pyinstaller pyinstaller run.spec --clean --noconfirm

# macOS: build the .app, then sign (Developer ID if MACOS_SIGN_IDENTITY is set,
# otherwise ad-hoc), smoke test it and wrap it into a DMG. See deploy/macos/README.md.
package-macos: package
    deploy/macos/package.sh sign
    deploy/macos/package.sh smoke
    deploy/macos/package.sh dmg

# Run the unified launcher locally (dev): migrations + worker + API + open UI.
run-desktop:
    uv run python run.py